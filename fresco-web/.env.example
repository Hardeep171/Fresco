# FRESCO Web Platform - Environment Configuration
# Production on Render: set to your deployed Render backend web service URL
# e.g., https://<your-fresco-backend>.onrender.com/api/v1
# Local development: leave blank or omit to use the built-in Vite dev server proxy (/api/v1 -> http://localhost:5000)
VITE_API_BASE_URL=https://<your-fresco-backend>.onrender.com/api/v1
