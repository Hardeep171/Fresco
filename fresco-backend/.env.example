NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/fresco
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-a-unique-access-secret-of-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-unique-refresh-secret-of-at-least-32-characters
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
